# Pingnom Backend API - Environment Variables

# Server Configuration
PORT=8090
GIN_MODE=debug
HOST=localhost

# Database Configuration (Development - InMemory)
DATABASE_TYPE=inmemory

# Database Configuration (Production - PostgreSQL)
# DATABASE_TYPE=postgresql
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=pingnom
# DATABASE_USER=pingnom_user
# DATABASE_PASSWORD=your_secure_password
# DATABASE_SSL_MODE=disable

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRY_HOURS=24

# Test Data Configuration
ENABLE_TEST_DATA=true
ENABLE_TEST_USERS=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:19006

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100