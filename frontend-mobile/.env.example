# Pingnom Mobile App Environment Variables

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8090/api/v1
EXPO_PUBLIC_API_HEALTH_URL=http://localhost:8090/health

# Development Settings
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug

# Test Configuration
EXPO_PUBLIC_ENABLE_QUICK_LOGIN=true

# Production Settings (for future use)
# EXPO_PUBLIC_API_BASE_URL=https://api.pingnom.app/api/v1
# EXPO_PUBLIC_API_HEALTH_URL=https://api.pingnom.app/health
# EXPO_PUBLIC_DEBUG_MODE=false
# EXPO_PUBLIC_LOG_LEVEL=error
# EXPO_PUBLIC_ENABLE_QUICK_LOGIN=false